pkgname=asus-px-keyboard-tool-git
_pkgname=asus-px-keyboard-tool
pkgver=r45.4766393   # overwritten by pkgver()
pkgrel=1
pkgdesc="Fix Fn-lock and missing hotkeys on Asus PX/ROG keyboards via HID-BPF"
arch=('x86_64')
url="https://github.com/a-chaudhari/asus-px-keyboard-tool"
license=('GPL-2.0-or-later')
makedepends=('git' 'rust' 'clang' 'llvm')
depends=('glibc' 'gcc-libs' 'systemd-libs' 'libevdev' 'elfutils' 'zlib')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto' '!debug')   # no LTO (lld can't link GCC-LTO libbpf.a); skip the split -debug package
source=("$_pkgname::git+https://github.com/a-chaudhari/asus-px-keyboard-tool.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

package() {
  cd "$srcdir/$_pkgname"
  install -Dm755 target/release/$_pkgname "$pkgdir/usr/bin/$_pkgname"
  # repoint service ExecStart off /usr/local onto /usr/bin (keep the .service name)
  sed 's|/usr/local/bin/|/usr/bin/|' "$_pkgname.service" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/$_pkgname.service"
  install -Dm644 "$_pkgname.conf" "$pkgdir/etc/$_pkgname.conf"
  install -dm755 "$pkgdir/var/lib/asus-px-kb-tool"
}
